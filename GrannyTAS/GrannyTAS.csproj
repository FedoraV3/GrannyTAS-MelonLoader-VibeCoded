<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MelonLoader 0.7.3 loads IL2CPP mods on the net6 runtime. -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GrannyTAS</AssemblyName>
    <RootNamespace>GrannyTAS</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- IL2CPP interop assemblies are full of these; not worth the noise. -->
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Library projects do not copy NuGet assemblies to the output directory by
         default, which would leave ImGui.NET.dll unavailable to deploy. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Override on the command line if the game lives elsewhere:
       dotnet build -p:GameDir="D:\Games\Granny_Legacy" -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(USERPROFILE)\Desktop\Granny_Legacy</GameDir>
    <MlDir>$(GameDir)\MelonLoader\net6</MlDir>
    <Il2CppDir>$(GameDir)\MelonLoader\Il2CppAssemblies</Il2CppDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <ImGuiVersion>1.91.6.1</ImGuiVersion>
    <CimguiDll>$(NuGetPackageRoot)imgui.net\$(ImGuiVersion)\runtimes\win-x64\native\cimgui.dll</CimguiDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dear ImGui proper. The managed wrapper goes to UserLibs (MelonLoader
         resolves mod dependencies from there; putting it in Mods would make ML
         try to load it as a mod). The native cimgui.dll must sit next to the
         executable so the P/Invoke resolves. -->
    <PackageReference Include="ImGui.NET" Version="$(ImGuiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MlDir)\MelonLoader.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MlDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MlDir)\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MlDir)\Il2CppInterop.Common.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Game + engine proxies. These are generated by MelonLoader on first
         launch; if the build cannot find them, run the game once. -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Il2CppDir)\Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Il2CppDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Il2CppDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(Il2CppDir)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(Il2CppDir)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(Il2CppDir)\UnityEngine.AIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Il2CppDir)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(Il2CppDir)\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(Il2CppDir)\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="FailIfNoGame" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(Il2CppDir)\Assembly-CSharp.dll')"
           Text="Il2CppAssemblies not found at '$(Il2CppDir)'. Launch the game once with MelonLoader installed to generate them, or pass -p:GameDir=&lt;path&gt;." />
  </Target>

  <!-- Drop the built mod straight into the game's Mods folder. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(NoDeploy)' != 'true'">
    <!-- The game holds a lock on the mod DLL while running, so this copy fails
         whenever Granny is open. Report that honestly instead of printing a
         success line over a silently-swallowed failure. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="_DeployedFiles" />
    </Copy>
    <Message Condition="'@(_DeployedFiles)' != ''" Importance="high"
             Text="Deployed $(TargetFileName) -> $(GameDir)\Mods" />

    <!-- Managed ImGui wrapper -> UserLibs, native cimgui -> game root. -->
    <Copy SourceFiles="$(OutDir)ImGui.NET.dll" DestinationFolder="$(GameDir)\UserLibs"
          ContinueOnError="WarnAndContinue" Condition="Exists('$(OutDir)ImGui.NET.dll')" />
    <Copy SourceFiles="$(CimguiDll)" DestinationFolder="$(GameDir)"
          ContinueOnError="WarnAndContinue" Condition="Exists('$(CimguiDll)')" />
    <Warning Condition="!Exists('$(CimguiDll)')"
             Text="cimgui.dll not found at '$(CimguiDll)' — the ImGui UI will fall back to the legacy overlay." />
    <Warning Condition="'@(_DeployedFiles)' == ''"
             Text="DEPLOY FAILED: could not write $(GameDir)\Mods\$(TargetFileName). Granny Legacy is probably running and holding the file — close the game and rebuild." />
  </Target>

</Project>
